# Copy to .env and fill in your own values. Never commit a real .env.

# LLM provider: "anthropic" | "openai" | "extractive" (no key needed).
# Without a key for the chosen provider, the service falls back to the
# extractive answer mode and labels answers as such.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vector store
CHROMA_DIR=./chroma_db
COLLECTION=agentic-rag-docs

# Retrieval + reranking
TOP_K=5
# RERANKER: "cosine" (default, no extra model) or "cross-encoder"
RERANKER=cosine

# Confidence gate (see agent/gate.py)
MIN_TOP_SCORE=0.35
AMBIGUITY_GAP=0.05
